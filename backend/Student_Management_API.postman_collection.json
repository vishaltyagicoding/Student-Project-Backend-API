        {
          "name": "Search Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/students/students/search/?q=john",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "students", "search", ""],
              "query": [
                {
                  "key": "q",
                  "value": "john"
                }
              ]
            }
          }
        },
        {
          "name": "Send Bulk Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_ids\": [1, 2, 3],\n  \"subject\": \"Important Announcement\",\n  \"message\": \"This is a test bulk email message.\"\n}"
