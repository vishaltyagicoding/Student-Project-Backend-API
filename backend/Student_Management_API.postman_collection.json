              "host": ["{{base_url}}"],
              "path": ["api", "students", "students", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "college",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
