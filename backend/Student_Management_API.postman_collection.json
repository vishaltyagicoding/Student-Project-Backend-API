              "raw": "{\n  \"students\": [\n    {\n      \"first_name\": \"John\",\n      \"last_name\": \"Doe\",\n      \"email\": \"john.doe@example.com\",\n      \"student_id\": \"STU001\",\n      \"college\": 1,\n      \"course\": 1,\n      \"branch\": 1\n    },\n    {\n      \"first_name\": \"Jane\",\n      \"last_name\": \"Smith\",\n      \"email\": \"jane.smith@example.com\",\n      \"student_id\": \"STU002\",\n      \"college\": 1,\n      \"course\": 1,\n      \"branch\": 1\n    },\n    {\n      \"first_name\": \"Bob\",\n      \"last_name\": \"Johnson\",\n      \"email\": \"bob.johnson@example.com\",\n      \"student_id\": \"STU003\",\n      \"college\": 1,\n      \"course\": 1,\n      \"branch\": 1\n    }\n  ]\n}"
            },
            "url": {
